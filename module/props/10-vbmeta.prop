# name: AVB / vbmeta
# description: Android Verified Boot metadata props. {vbmeta_size} expands to the randomised size stored in config.sh; {avb_version} expands to the avb_version key, so the two AVB version props can never drift apart.
# enabled: 1

missing        ro.boot.vbmeta.invalidate_on_error  yes
missing_match  ro.boot.vbmeta.avb_version          {avb_version}
missing        ro.boot.vbmeta.hash_alg             sha256
missing        ro.boot.vbmeta.size                 {vbmeta_size}
missing_match  ro.boot.vbmeta.device_state         locked
reset          vendor.boot.vbmeta.device_state     locked

# ro.boot.avb_version is the bootloader-level companion to
# ro.boot.vbmeta.avb_version above. A real device reports the same
# version in both, so both read {avb_version} - change avb_version in
# config.sh once and they move together. Setting one to 1.2 and the
# other to 1.3 is itself a detection signal, which is why this is a
# token and not a literal.
#
# Both use missing_match, not missing: 'missing' does nothing when a
# prop already exists, and on a device where only ONE of the pair is
# present that leaves the two disagreeing - which is the exact signal
# this is meant to close. missing_match makes both converge.
#
# avb_version defaults to 'auto', which resolves to whichever version
# the device itself reports (see nyx_resolve_avb_version in utils.sh).
# The BRENE fork forces 1.3 for both.
missing_match  ro.boot.avb_version                 {avb_version}
